# Non-secret settings for production on Docker Compose (docs/secrets.md). Used with:
#   oncall-secrets compose --settings production.env up -d
# Secrets never go here: every token, password and API key comes from the vault, and
# oncall-secrets refuses to start if this file names one.
ONCALL_AGENT_FLAVOR=anthropic
# ONCALL_REASONING_MODEL=
# ONCALL_FAST_MODEL=
# ONCALL_AUTONOMY_MODE=read-only
# ONCALL_JEV_ENABLED=false
