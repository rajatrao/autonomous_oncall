{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatrao/oncall/schemas/incident-state/1.0",
  "title": "Incident State",
  "description": "Durable incident record. This, not the LLM conversation, is the source of truth for an incident. Returned by the incident-state MCP server's get_incident tool and by the gateway API.",
  "type": "object",
  "required": ["incident_id", "severity", "service", "environment", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "incident_id": {"type": "string"},
    "severity": {"type": "string", "enum": ["SEV1", "SEV2", "SEV3", "SEV4", "SEV5"]},
    "service": {"type": "string"},
    "environment": {"type": "string"},
    "summary": {"type": "string"},
    "status": {
      "type": "string",
      "enum": [
        "DETECTED",
        "TRIAGING",
        "INVESTIGATING",
        "ROOT_CAUSE_IDENTIFIED",
        "REMEDIATION_PROPOSED",
        "REMEDIATING",
        "VERIFYING",
        "RECOVERED",
        "CLOSED"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "triage": {
      "type": ["object", "null"],
      "description": "Structured triage result (see agent output contracts).",
      "properties": {
        "severity": {"type": "string"},
        "scope": {"type": "string"},
        "impact": {"type": "string"},
        "affected_services": {"type": "array", "items": {"type": "string"}},
        "affected_dependencies": {"type": "array", "items": {"type": "string"}},
        "initial_symptoms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "current_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "hypothesis": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["open", "supported", "rejected", "confirmed"]}
        }
      }
    },
    "root_cause": {"type": ["string", "null"]},
    "root_cause_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "root_cause_confirmed": {
      "type": "boolean",
      "description": "True only once remediation targeting the root cause was followed by verified recovery. Confidence alone never confirms."
    },
    "actions": {"type": "array", "items": {"$ref": "remediation.schema.json"}},
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "kind", "message"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "kind": {"type": "string"},
          "actor": {"type": "string"},
          "message": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    },
    "communications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "kind": {"type": "string"},
          "channel": {"type": ["string", "null"]},
          "message": {"type": "string"},
          "delivered": {"type": "boolean"},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "rca": {
      "type": ["object", "null"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "final"]},
        "sections": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeline": {"type": "array"}
      }
    },
    "tasks": {"type": "array", "items": {"$ref": "agent-task.schema.json"}}
  },
  "additionalProperties": true
}
