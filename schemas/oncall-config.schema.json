{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatrao/oncall/schemas/oncall-config/1",
  "title": "On-call agent deployment configuration",
  "description": "Customer configuration for the gateway and MCP servers. Changing this file never requires changing agent logic. String values may reference environment variables as ${VAR} or ${VAR:-default}; secrets must be referenced this way, never written inline.",
  "type": "object",
  "required": [
    "config_version"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "organization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "incident": {
      "type": "object",
      "properties": {
        "default_severity": {
          "type": "string",
          "enum": [
            "SEV1",
            "SEV2",
            "SEV3",
            "SEV4",
            "SEV5"
          ]
        },
        "default_environment": {
          "type": "string"
        },
        "auto_close_after_recovery": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "postgres",
            "sqlite",
            "memory"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ingestion": {
      "type": "object",
      "properties": {
        "webhook": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "auth_token": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "queue": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "none",
                "redis_streams"
              ]
            },
            "url": {
              "type": "string"
            },
            "stream": {
              "type": "string"
            },
            "group": {
              "type": "string"
            },
            "consumer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "docker-agent-api",
            "docker-agent-exec",
            "none"
          ]
        },
        "api_url": {
          "type": "string"
        },
        "api_token": {
          "type": "string"
        },
        "agent_id": {
          "type": "string",
          "description": "Agent identifier on the API server: the config filename without extension."
        },
        "agent_ref": {
          "type": "string",
          "description": "For docker-agent-exec: local file, OCI reference or alias."
        },
        "binary": {
          "type": "string"
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": "string",
          "enum": [
            "restricted",
            "balanced",
            "strict",
            "autonomous"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 10
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "wake_agent": {
          "type": "string",
          "description": "Named agent to run (default: the root agent)."
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra docker-agent run arguments for docker-agent-exec (for example --data-dir)."
        },
        "retry_backoff_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "observability": {
          "$ref": "#/$defs/provider"
        },
        "logs": {
          "$ref": "#/$defs/provider"
        },
        "traces": {
          "$ref": "#/$defs/provider"
        },
        "changes": {
          "$ref": "#/$defs/provider"
        },
        "remediation": {
          "$ref": "#/$defs/provider"
        },
        "communications": {
          "$ref": "#/$defs/provider"
        },
        "knowledge": {
          "$ref": "#/$defs/provider"
        },
        "incident_management": {
          "$ref": "#/$defs/provider"
        }
      },
      "additionalProperties": false
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "read-only",
            "supervised",
            "autonomous"
          ]
        },
        "investigation": {
          "type": "string",
          "enum": [
            "automatic"
          ]
        },
        "diagnosis": {
          "type": "string",
          "enum": [
            "automatic"
          ]
        },
        "remediation": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "automatic",
                "approval_required",
                "disabled"
              ]
            },
            {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "restart": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "rollback": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "scale": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "failover": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "circuit_breaker": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                },
                "feature_flag": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "approval_required",
                    "disabled"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "rollback": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string",
              "enum": [
                "automatic",
                "approval_required",
                "disabled"
              ]
            }
          }
        },
        "failover": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string",
              "enum": [
                "automatic",
                "approval_required",
                "disabled"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "properties": {
        "allowed_services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns of services the agent may act on."
        },
        "protected_services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Services that always require approval, whatever the autonomy mode."
        },
        "failover_targets": {
          "type": "object",
          "description": "Approved failover targets per dependency. Failover to anything else is denied.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "scale": {
          "type": "object",
          "properties": {
            "min_replicas": {
              "type": "integer",
              "minimum": 0
            },
            "max_replicas": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "feature_flags": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "max_actions_per_incident": {
          "type": "integer",
          "minimum": 0
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category_actions": {
          "type": "object",
          "description": "Optional, tighten-only: per diagnosis category, the remediation categories that may run without approval. Any other category for that diagnosis requires approval. Categories not listed are unaffected.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "restart",
                "rollback",
                "scale",
                "failover",
                "circuit_breaker",
                "feature_flag"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "description": "Per-server bearer tokens. Each MCP server only accepts its own token (least privilege).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "auth_token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "description": "Incident gateway: HTTP API, approvals and the durable task worker.",
      "properties": {
        "api_token": {
          "type": "string",
          "description": "Bearer token for reading incidents. Empty disables auth (loopback/dev only)."
        },
        "approver_token": {
          "type": "string",
          "description": "Bearer token allowed to approve or reject remediation actions."
        },
        "cors_origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "followup_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Re-wake open incidents that are waiting on evidence or recovery after this many idle seconds. 0 disables."
        },
        "max_followups": {
          "type": "integer",
          "minimum": 0
        },
        "poll_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "allow_reset": {
          "type": "boolean",
          "description": "Expose POST /v1/admin/reset (demo environments only)."
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional decision model (TypeSafe Jev API, also served by Ollama for local models such as Nimble) for bounded decisions made by the MCP servers. Off by default; see docs/decisions.md.",
      "properties": {
        "enabled": {
          "description": "true or false (a string is accepted so the value can come from ${VAR}).",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                "True",
                "False",
                "1",
                "0",
                "yes",
                "no",
                ""
              ]
            }
          ]
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ollama",
                "typesafe",
                "systemone",
                "mock",
                "none"
              ],
              "description": "ollama and typesafe are both /v1/systemone endpoints; systemone is any compatible endpoint; mock is for tests."
            },
            "url": {
              "type": "string",
              "description": "Base URL; the provider appends /systemone. Ollama: http://localhost:11434/v1. TypeSafe: https://api.typesafe.ai/v1."
            },
            "model": {
              "type": "string",
              "description": "nimble (Ollama), jev-latest or a pinned jev-1.13.0 (TypeSafe)."
            },
            "api_key": {
              "type": "string",
              "description": "Reference it as ${ONCALL_JEV_API_KEY}; never inline."
            },
            "allow_external": {
              "description": "Required to send incident data to a non-local, non-private host.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False",
                    "1",
                    "0",
                    "yes",
                    "no",
                    ""
                  ]
                }
              ]
            },
            "timeout_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 50,
                  "maximum": 60000
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                }
              ]
            },
            "max_retries": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                }
              ]
            },
            "answers": {
              "type": "object",
              "description": "mock only"
            },
            "fail": {
              "type": "string",
              "description": "mock only"
            }
          }
        },
        "default_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "shadow",
                "active"
              ]
            },
            {
              "type": "string",
              "enum": [
                ""
              ]
            }
          ]
        },
        "enabled_decisions": {
          "description": "Decision types to run, as a list or a comma-separated string.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "runbook_selection",
                  "diagnosis_category",
                  "severity",
                  "evidence_sufficiency",
                  "remediation_consistency"
                ]
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "fallback": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "baseline",
                "llm",
                "escalate"
              ]
            },
            {
              "type": "string",
              "enum": [
                ""
              ]
            }
          ]
        },
        "environments": {
          "description": "Only consult the decision model for incidents in these environments (empty: all).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "per_decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runbook_selection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "shadow",
                    "active"
                  ]
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "llm",
                    "escalate"
                  ]
                },
                "min_confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                    }
                  ],
                  "description": "Required in active mode. Set it from shadow-mode data: decision-model probabilities are not calibrated accuracy."
                }
              }
            },
            "diagnosis_category": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "shadow",
                    "active"
                  ]
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "llm",
                    "escalate"
                  ]
                },
                "min_confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                    }
                  ],
                  "description": "Required in active mode. Set it from shadow-mode data: decision-model probabilities are not calibrated accuracy."
                }
              }
            },
            "severity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "shadow",
                    "active"
                  ]
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "llm",
                    "escalate"
                  ]
                },
                "min_confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                    }
                  ],
                  "description": "Required in active mode. Set it from shadow-mode data: decision-model probabilities are not calibrated accuracy."
                }
              }
            },
            "evidence_sufficiency": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "shadow",
                    "active"
                  ]
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "llm",
                    "escalate"
                  ]
                },
                "min_confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                    }
                  ],
                  "description": "Required in active mode. Set it from shadow-mode data: decision-model probabilities are not calibrated accuracy."
                }
              }
            },
            "remediation_consistency": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "shadow",
                    "active"
                  ]
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "llm",
                    "escalate"
                  ]
                },
                "min_confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                    }
                  ],
                  "description": "Required in active mode. Set it from shadow-mode data: decision-model probabilities are not calibrated accuracy."
                }
              }
            }
          }
        },
        "llm_fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": "string",
              "description": "OpenAI-compatible base URL, e.g. http://localhost:11434/v1"
            },
            "model": {
              "type": "string"
            },
            "api_key": {
              "type": "string"
            },
            "allow_external": {
              "description": "true or false (a string is accepted so the value can come from ${VAR}).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false",
                    "True",
                    "False",
                    "1",
                    "0",
                    "yes",
                    "no",
                    ""
                  ]
                }
              ]
            },
            "confidence_when_llm": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
                }
              ],
              "description": "Confidence assigned to fallback LLM answers (a chat model gives no probabilities). Required for fallback: llm."
            }
          }
        },
        "root_cause_min_confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
            }
          ],
          "description": "set_root_cause rejects an unconfirmed root cause below this confidence. Applies even when decisions are disabled."
        },
        "root_cause_min_evidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?)?\\s*$"
            }
          ],
          "description": "Minimum evidence items for an unconfirmed root cause. Applies even when decisions are disabled."
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
