{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatrao/oncall/schemas/remediation/1.0",
  "title": "Remediation Action",
  "description": "A typed, policy-checked, auditable production change. The LLM can only request one of the typed actions below; it never receives a shell.",
  "type": "object",
  "required": ["action_id", "incident_id", "action", "params", "status", "decision"],
  "properties": {
    "action_id": {"type": "string"},
    "incident_id": {"type": "string"},
    "action": {
      "type": "string",
      "enum": [
        "restart_service",
        "rollback_deployment",
        "scale_service",
        "failover_dependency",
        "enable_circuit_breaker",
        "disable_feature_flag"
      ]
    },
    "category": {"type": "string", "enum": ["restart", "rollback", "scale", "failover", "circuit_breaker", "feature_flag"]},
    "params": {"type": "object"},
    "justification": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "idempotency_key": {"type": "string"},
    "decision": {
      "type": "object",
      "required": ["outcome", "reason"],
      "properties": {
        "outcome": {"type": "string", "enum": ["allow", "require_approval", "deny"]},
        "reason": {"type": "string"},
        "policy_mode": {"type": "string", "enum": ["read-only", "supervised", "autonomous"]}
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending_approval", "approved", "rejected", "denied", "executing", "succeeded", "failed"]
    },
    "approved_by": {"type": ["string", "null"]},
    "result": {"type": ["object", "null"]},
    "error": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
