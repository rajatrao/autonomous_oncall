# Variables read by compose.yaml. `./scripts/demo.sh up` generates .env with random tokens;
# copy this file only if you want to set them yourself. Never commit .env.
# .env is for local development only. In production, secrets come from a vault
# (`oncall-secrets compose`) or Kubernetes Secrets, never from .env; see docs/secrets.md.
#
# Model (see docs/models.md; `./scripts/demo.sh model ...` sets these). Default: keyless scripted model.
# One of: scripted-model, dmr, ollama, anthropic, openai, openai-compatible
ONCALL_AGENT_FLAVOR=scripted-model
# ONCALL_REASONING_MODEL=ai/qwen3.6:35b-a3b
# ONCALL_FAST_MODEL=ai/qwen3.6:35b-a3b
# MODEL_RUNNER_HOST=http://model-runner.docker.internal
# ONCALL_OLLAMA_URL=http://host.docker.internal:11434/v1   # http://ollama:11434/v1 for the container
# COMPOSE_PROFILES=ollama                 # run Ollama in a container (`./scripts/demo.sh ollama docker`)
# OLLAMA_VERSION=0.35.1
# ONCALL_MODEL_BASE_URL=   (openai-compatible only)
# ONCALL_MODEL_API_KEY=                   # the key for any hosted provider (Anthropic, OpenAI, a gateway)
# ONCALL_AGENT_REF=docker.io/<org>/oncall-agent:0.1.0   # run a published artifact instead of dist/
# DOCKER_AGENT_VERSION=1.149.0

# Optional decision model (docs/decisions.md; `./scripts/demo.sh jev ...` sets these). Off by default.
# ONCALL_JEV_ENABLED=false
# ONCALL_JEV_PROVIDER=ollama               # ollama | typesafe | systemone
# ONCALL_JEV_URL=http://host.docker.internal:11434/v1
# ONCALL_JEV_MODEL=nimble                  # or jev-latest / jev-1.13.0 with typesafe
# ONCALL_JEV_API_KEY=                      # hosted only
# ONCALL_JEV_DECISIONS=                    # empty: all; or e.g. runbook_selection,diagnosis_category
# ONCALL_JEV_FALLBACK=baseline             # baseline | escalate | llm
# ONCALL_JEV_TIMEOUT_MS=1500

# Autonomy overrides (see docs/configuration.md)
# ONCALL_AUTONOMY_MODE=autonomous          # read-only | supervised | autonomous
# ONCALL_FAILOVER_MODE=automatic           # automatic | approval_required | disabled
# ONCALL_ROLLBACK_MODE=approval_required

# Tokens: one per boundary, so each container only gets what it needs.
ONCALL_INGEST_TOKEN=
ONCALL_GATEWAY_API_TOKEN=
ONCALL_GATEWAY_APPROVER_TOKEN=
ONCALL_AGENT_API_TOKEN=
ONCALL_INCIDENT_STATE_MCP_TOKEN=
ONCALL_OBSERVABILITY_MCP_TOKEN=
ONCALL_CHANGES_MCP_TOKEN=
ONCALL_REMEDIATION_MCP_TOKEN=
ONCALL_COMMUNICATIONS_MCP_TOKEN=
ONCALL_KNOWLEDGE_MCP_TOKEN=
PLATFORM_CHANGES_READ_TOKEN=
PLATFORM_OPS_TOKEN=
PLATFORM_DEPLOY_TOKEN=
CHAOS_TOKEN=
SLACK_BOT_TOKEN=
SLACK_API_URL=
SLACK_ANNOUNCE_CHANNEL=
POSTGRES_PASSWORD=
ONCALL_DB_PASSWORD=
PAYMENTS_DB_PASSWORD=
